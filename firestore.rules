rules_version = '2';

// Each signed-in user can read and write only the documents under their own
// users/{uid} path. The only other thing anyone can read is a share link a
// user created on purpose, and only until it expires.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Share links: readable by anyone who has the link until expires_at
    // (no expiry when it is null). Only the owner can create or delete them.
    match /shares/{id} {
      allow get: if resource.data.expires_at == null || resource.data.expires_at > request.time;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(["owner", "kind", "title", "text", "html", "url", "source", "focus", "ink", "created_at", "expires_at"])
        && (request.resource.data.expires_at == null || request.resource.data.expires_at is timestamp);
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
  }
}
